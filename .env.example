# Local Supabase defaults (from `supabase start`). Never commit real keys.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# On-chain anchoring (server only; set in Vercel, never commit). Leave ANCHOR_PRIVATE_KEY empty
# to switch anchoring off. Use a throwaway wallet holding only testnet funds.
ANCHOR_PRIVATE_KEY=
ANCHOR_CHAIN=sepolia
# Optional RPC override for the server (defaults to the chain's public RPC).
ANCHOR_RPC_URL=

# Browser (public): optional RPC for the audit page and the expected anchor wallet address.
# VITE_SEPOLIA_RPC_URL=
# VITE_ANCHOR_ADDRESS=

# Seconds between freeze and submissions opening when the owner set no opens_at.
OPEN_DELAY_SECONDS=86400
